{
  "name": "hfpc-minesweeper",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "_note_prebuild": "⚠ build 前一定要先清 dist —— 路徑含中文時 Node 24 的 fs.rm 會硬當掉整個 process(Windows 0xC0000409),而 vite 的 emptyOutDir 正是用它 ⇒ dist 存在就必炸,畫面只停在『transformed』像卡住。原因與實測見 scripts/clean-dist.mjs 檔頭。",
    "prebuild": "node scripts/clean-dist.mjs",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host --port 4173",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "node scripts/verify-browser.mjs",
    "deploy": "npm run build && wrangler deploy",
    "bench": "node scripts/bench-gen.mjs",
    "icons": "node scripts/gen-icons.mjs",
    "check:offline": "node scripts/check-offline.mjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "playwright": "^1.63.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vite-plugin-pwa": "^0.20.5",
    "vitest": "^2.1.9"
  }
}
